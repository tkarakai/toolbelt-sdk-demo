{
  "formatVersion": 1,
  "id": "sdk-demo",
  "name": "SDK Explorer",
  "description": "An interactive guide to every public Toolbelt UI, action and lifecycle capability. Safe to remove.",
  "icon": "blocks",
  "version": "0.4.0",
  "protocol": 3,
  "entry": "index.js",
  "repo": "tkarakai/toolbelt-sdk-demo",
  "requires": {
    "host": ">=0.10.0",
    "bun": ">=1.3.0",
    "platforms": [
      "portable"
    ]
  },
  "capabilities": {
    "required": [
      "ui.core",
      "ui.action-key",
      "ui.terminal",
      "assets",
      "lifecycle",
      "ui.rich-fields",
      "ui.row-select",
      "ui.row-reorder",
      "ui.modifier-keys",
      "ui.filter-group",
      "ui.choice-control",
      "ui.floating",
      "ui.split-action",
      "navigate",
      "ui.row-pane"
    ],
    "optional": [
      "ui.conversation",
      "native.handoff",
      "ui.options-field",
      "ui.timeline",
      "ui.composer",
      "ui.toast-key"
    ]
  },
  "data": {
    "schema": 1
  },
  "assets": {
    "badge": "assets/badge.svg"
  },
  "screens": [
    {
      "id": "gallery",
      "title": "Gallery",
      "icon": "layout-grid",
      "default": true,
      "shortcut": "g"
    },
    {
      "id": "table",
      "title": "Tables",
      "icon": "table",
      "shortcut": "t"
    },
    {
      "id": "views",
      "title": "Views",
      "icon": "list-filter",
      "shortcut": "v"
    },
    {
      "id": "actions",
      "title": "Actions",
      "icon": "zap",
      "shortcut": "a"
    },
    {
      "id": "forms",
      "title": "Forms",
      "icon": "sliders-horizontal",
      "shortcut": "f"
    },
    {
      "id": "output",
      "title": "Output",
      "icon": "terminal",
      "shortcut": "o"
    },
    {
      "id": "lifecycle",
      "title": "Lifecycle",
      "icon": "refresh-cw",
      "shortcut": "l"
    }
  ],
  "quickView": true,
  "floating": {
    "shortcut": "j"
  },
  "migration": {
    "entry": "migrate.js"
  },
  "handoffActions": [
    "handoff-count"
  ],
  "agent": {
    "access": "act"
  }
}
